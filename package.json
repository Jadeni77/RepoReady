{
    "name": "repoready-monorepo",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build -w @repoready/core && npm run build -w @repoready/plugin-node && npm run build -w @repoready/plugin-python && npm run build -w @repoready/plugin-github && npm run build -w repoready-cli",
        "dev": "npm run build -w @repoready/core && npm run dev -w repoready-cli --",
        "doctor": "npm run dev -- doctor",
        "pretypecheck": "npm run build",
        "typecheck": "tsc -p tsconfig.base.json --noEmit",
        "pretest": "npm run build",
        "test": "node --import tsx --test \"packages/*/test/*.test.ts\"",
        "check": "npm run typecheck && npm test"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "tsup": "^8.0.0",
        "tsx": "^4.0.0",
        "typescript": "^5.0.0",
        "yaml": "^2.9.0"
    },
    "engines": {
        "node": ">=22"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.0.0"
    }
}
