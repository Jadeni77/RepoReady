{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "resolveJsonModule": true,
        "esModuleInterop": true
    },
    "include": ["packages/**/*.ts"]
}